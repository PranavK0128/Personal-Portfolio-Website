# Public form endpoint from your Formspree dashboard. No private API key needed.
# Verify the recipient as PranavK0128@gmail.com in Formspree.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xpppdnbk

# Visitors: local development automatically uses .local-data/visitors.sqlite.
# DigitalOcean production requires a persistent path outside release folders,
# the site's actual HTTPS origin, and a trusted reverse proxy's single-IP header.
# Keep the Node port private; nginx must OVERWRITE this header for every request.
# VISITORS_DB_PATH=/var/lib/pranav-portfolio/visitors.sqlite
# VISITORS_SITE_ORIGIN=https://your-domain.example
# VISITORS_IP_HEADER=x-real-ip
